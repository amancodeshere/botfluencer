# Copy to ~/.config/botfluencer/blue.env; chmod 600. Never store account tokens here.
BLUE_NAMESPACE=ctn-2026
BLUE_ARTIFACT=/mnt/d/botfluencer/models/blue-active
BLUE_INTERVAL_SECONDS=30
BLUE_MAX_PAGES=3
BLUE_SCORE_LIMIT=128
BLUE_BATCH_SIZE=8
BLUE_MAX_AGE_HOURS=24
BLUE_MIN_AUTHOR_HITS=2
BLUE_ENABLE_REPORTS=false
BLUE_AUTO_REPORT=false
BLUE_OWN_AUTHOR_IDS='[]'
BLUE_MAX_PENDING_REPORTS=1
BLUE_MAX_REPORTS_PER_HOUR=3
# BLUE_SESSION_TOKEN belongs only in the private copy, if reporting is enabled later.
