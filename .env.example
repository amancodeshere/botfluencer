# Local development only. Railway supplies DATABASE_URL via a reference variable.
# Populate from your approved Railway Postgres service; no local DB fallback.
DATABASE_URL=
BOT_NAMESPACE=local-replay
BOT_MODE=replay
BOT_PLATFORM_BACKEND=mock
BOT_STRATEGY=noop
# Optional public role/strategy file. Account IDs must match BOT_ACCOUNTS.
# BOT_BOT_PROFILES_FILE=configs/bots.example.toml
BOT_ACCOUNTS=["mock-01"]
BOT_POLL_INTERVAL_SECONDS=5
BOT_OPERATION_TIMEOUT_SECONDS=30
BOT_HEARTBEAT_TIMEOUT_SECONDS=60
BOT_MAX_ACTIONS_PER_HOUR=60
BOT_ACCOUNT_COOLDOWN_SECONDS=5
BOT_MAX_LLM_CALLS_PER_HOUR=60
BOT_MAX_ACTION_ATTEMPTS=3
BOT_RETRY_BASE_SECONDS=2
BOT_FIXTURE_PATH=fixtures/feed.jsonl
PORT=8000

# Team code is also the competition LLM API key. Never commit an actual value.
CTN_TEAM_CODE=
# Copy your assigned side from the portal: Vote Yes or Vote No.
# CTN_SIDE=Vote Yes
# Copy the current allowances from the portal; never infer these from past events.
# CTN_MAX_TOTAL_ACCOUNTS=
# CTN_MAX_ACTIVE_ACCOUNTS=
CTN_NETWORK_ENABLED=false
CTN_FEED=trending
CTN_FEED_LIMIT=20
CTN_LLM_MAX_TOKENS=150
